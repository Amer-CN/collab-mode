{
  "version": "1.3.0",
  "rules": {
    "file": "collab-rules.md",
    "placeholders": {
      "ADVISOR": {
        "dsh": "`advisor`",
        "zcode": "`advisor-A` / `advisor-B` / `advisor-C`"
      },
      "GENERIC": {
        "dsh": "通用子智能体",
        "zcode": "`general-purpose`"
      },
      "EXPLORE": {
        "dsh": "只读探索类子智能体",
        "zcode": "`Explore` 或 `general-purpose`"
      },
      "ADVISOR_CALL": {
        "dsh": "分别调用 `advisor` 若干轮，并在设置面板为每轮换不同厂商的模型",
        "zcode": "同时调用 `advisor-A`、`advisor-B` 和 `advisor-C` 各出一轮意见；三席必须配置为不同厂商的模型，否则圆桌变复读"
      },
      "STEELMAN_TAIL": {
        "dsh": "。",
        "zcode": "；prompt 存于 `~/.zcode/snippets/two-way-steelman.md`，触发时先读该文件。"
      }
    }
  },
  "roles": [
    {
      "key": "executor",
      "file": "roles/executor.md",
      "dsh": {
        "toolName": "executor",
        "readonly": false
      },
      "zcode": {
        "description": "代码执行者。已有明确方案、需要实际改代码时使用。不做设计，不做审查。",
        "color": "orange",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Edit",
          "Write",
          "TodoWrite"
        ],
        "injectAgentsMd": true
      }
    },
    {
      "key": "code-reviewer",
      "file": "roles/code-reviewer.md",
      "dsh": {
        "toolName": "code-reviewer",
        "readonly": true
      },
      "zcode": {
        "description": "独立代码审查员。执行者改完代码后调用，直接检查仓库实际改动。只读。",
        "color": "red",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash"
        ],
        "injectAgentsMd": true
      }
    },
    {
      "key": "researcher",
      "file": "roles/researcher.md",
      "dsh": {
        "toolName": "researcher",
        "readonly": true
      },
      "zcode": {
        "description": "只读调研员。需要了解代码库现状、查找功能实现位置、收集事实、联网查资料、查 GitHub 仓库/文档/发布信息时使用。只读，不改代码，不做方案。",
        "color": "green",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "WebSearch",
          "WebFetch",
          "mcp__github__get_file_contents",
          "mcp__github__search_repositories",
          "mcp__github__search_code",
          "mcp__github__pull_request_read",
          "mcp__github__list_commits",
          "mcp__github__get_me",
          "mcp__github__list_releases",
          "mcp__github__list_issues",
          "mcp__github__get_release_by_tag",
          "mcp__github__search_issues",
          "mcp__github__list_tags"
        ],
        "toolsNote": "以下 GitHub MCP 工具仅在本机存在该 MCP 时保留，否则删除这几行：",
        "injectAgentsMd": true
      }
    },
    {
      "key": "advisor",
      "file": "roles/advisor.md",
      "dsh": {
        "toolName": "advisor",
        "readonly": true,
        "seatNote": "DSH 侧只有一个 advisor 工具（不拆三席）：模型可在设置面板随时改，要三家意见就调三次并各自指定模型。因此 DSH 侧角色数是 5，ZCode 侧是 7。"
      },
      "zcode": {
        "description": "独立顾问。用户想听多方意见时调用。只给判断和理由，不写代码。",
        "color": "green",
        "tools": [
          "Read"
        ],
        "injectAgentsMd": false,
        "nameNote": "另两个文件把 name 改为 advisor-B / advisor-C，其余完全相同",
        "seatNote": "ZCode 侧部署时拆成三席（advisor-A/B/C，仅 name 不同），因为 ZCode 的子智能体是静态文件、想同时问三家就得各绑一个模型。"
      }
    },
    {
      "key": "vision-reader",
      "file": "roles/vision-reader.md",
      "dsh": {
        "toolName": "vision-reader",
        "readonly": true
      },
      "zcode": {
        "description": "图像识别员。需要理解图片内容（截图、设计稿、报错界面、文档照片）而当前模型不具备识图能力时使用。只输出图片描述，不做分析建议。",
        "color": "purple",
        "tools": [
          "Read",
          "Glob"
        ],
        "injectAgentsMd": false
      }
    }
  ]
}
